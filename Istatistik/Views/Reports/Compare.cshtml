@using Istatistik.Models
@using Istatistik.Services
@{
    ViewBag.Title = "Dönem Karşılaştırma";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentUser = ViewBag.CurrentUser as CurrentUser ?? CurrentUser.FromSession(Session);
    bool canPasaport = currentUser == null || currentUser.CanAccessBureau(BureauCodes.Pasaport);
    bool canBilgiTek = currentUser == null || currentUser.CanAccessBureau(BureauCodes.BilgiTeknolojileri);
    bool canTrafik   = currentUser == null || currentUser.CanAccessBureau(BureauCodes.Trafik);
    bool canGbtUyap  = currentUser == null || currentUser.CanAccessBureau(BureauCodes.GbtUyap);
    bool canYts      = currentUser == null || currentUser.CanAccessBureau(BureauCodes.YtsSorgu);
    bool canIdari    = currentUser == null || currentUser.CanAccessBureau(BureauCodes.Idari);
    bool canGuvenlik = currentUser == null || currentUser.CanAccessBureau(BureauCodes.Guvenlik);
    bool canSucOnleme = currentUser == null || currentUser.CanAccessBureau(BureauCodes.SucOnleme);
    bool canSeyahat  = currentUser == null || currentUser.CanAccessBureau(BureauCodes.SeyahatBelgeRisk);
    bool hasAnyBureau = canPasaport || canBilgiTek || canTrafik || canGbtUyap || canYts || canIdari || canGuvenlik || canSucOnleme || canSeyahat;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="bi bi-arrow-left-right text-primary me-2"></i>Dönem Karşılaştırma</h2>
            <p class="text-muted mb-0">Havalimanı: <strong>@ViewBag.Border</strong></p>
        </div>
        <a href="/Reports/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Raporlara Dön
        </a>
    </div>

    @Html.AntiForgeryToken()

    <!-- Hata Container -->
    <div id="error-container"></div>

    <!-- Loading Spinner -->
    <div id="loader" class="text-center my-4" style="display: none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Yükleniyor...</span>
        </div>
        <p class="mt-2 text-muted">Karşılaştırma verileri hesaplanıyor...</p>
    </div>

    <!-- Filtreler -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label for="dataType" class="form-label fw-semibold">Veri Türü</label>
                    <select id="dataType" class="form-select">
                        @if (!hasAnyBureau)
                        {
                            <option value="" disabled selected>Yetkili olduğunuz bir büro bulunamadı</option>
                        }
                        @if (canPasaport)
                        {
                            <optgroup label="Pasaport">
                                <option value="yolcuucak">Yolcu/Uçak İstatistikleri</option>
                                <option value="gunluk">Günlük Zaman Serisi</option>
                                <option value="inad">İNAD Kayıtları</option>
                                <option value="tahdit">Tahdit Kayıtları</option>
                                <option value="haftalik">Haftalık Olay Çizelgesi</option>
                            </optgroup>
                        }
                        @if (canBilgiTek)
                        {
                            <optgroup label="Bilgi Teknolojileri">
                                <option value="bilgitek_KameraKaydiIncelemesi">Kamera Kaydı İncelemesi</option>
                                <option value="bilgitek_PtsAracAraniyor">PTS Araç Aranıyor</option>
                                <option value="bilgitek_PtsAracCalinti">PTS Araç Çalıntı</option>
                                <option value="bilgitek_PtsPlakaCalinti">PTS Plaka Çalıntı</option>
                                <option value="bilgitek_PtsPlakaKayip">PTS Plaka Kayıp</option>
                                <option value="bilgitek_TahditBakilanSorunluYolcu">Tahdit Bakılan Sorunlu Yolcu</option>
                                <option value="bilgitek_YurdaGirisCikisBelgeTalebi">Giriş/Çıkış Belge Talebi</option>
                                <option value="bilgitek_TahditEkleme">Tahdit Ekleme</option>
                                <option value="bilgitek_TahditKaldirma">Tahdit Kaldırma</option>
                            </optgroup>
                            <optgroup label="CCTV">
                                <option value="cctv_IpSabit">IP Sabit Kamera</option>
                                <option value="cctv_IpHareketli">IP Hareketli Kamera</option>
                                <option value="cctv_AnalogSabit">Analog Sabit Kamera</option>
                                <option value="cctv_AnalogHareketli">Analog Hareketli Kamera</option>
                            </optgroup>
                        }
                        @if (canTrafik)
                        {
                            <optgroup label="Trafik">
                                <option value="trafik_KontrolEdilenAracSayisi">Kontrol Edilen Araç</option>
                                <option value="trafik_CezaYazilanSurucuSayisi">Ceza Yazılan Sürücü</option>
                                <option value="trafik_TrafiktenMenEdilenAracSayisi">Trafikten Men Edilen Araç</option>
                                <option value="trafik_GeciciGeriAlinanSurucuBelgesi">Geri Alınan Sürücü Belgesi</option>
                            </optgroup>
                        }
                        @if (canGbtUyap)
                        {
                            <optgroup label="GBT / UYAP">
                                <option value="gbtuyap_SorgulananKisiSayisi">Sorgulanan Kişi</option>
                                <option value="gbtuyap_YakalananKisiSayisi">Yakalanan Kişi</option>
                            </optgroup>
                        }
                        @if (canYts)
                        {
                            <optgroup label="YTS Sorgu">
                                <option value="ytssorgu_GunlukSorguSayisi">Günlük Sorgu Sayısı</option>
                            </optgroup>
                        }
                        @if (canIdari)
                        {
                            <optgroup label="İdari Büro">
                                <option value="idari_GelenEvrak">Gelen Evrak</option>
                                <option value="idari_GidenEvrak">Giden Evrak</option>
                                <option value="idari_ToplamPersonelSayisi">Toplam Personel</option>
                                <option value="idari_IdariBuroPersonelSayisi">İdari Büro Personeli</option>
                            </optgroup>
                        }
                        @if (canGuvenlik)
                        {
                            <optgroup label="Güvenlik Hizmetleri">
                                <option value="guvenlik_GirisYapanArac">Giriş Yapan Araç</option>
                                <option value="guvenlik_KontrolEdilenArac">Kontrol Edilen Araç</option>
                            </optgroup>
                        }
                        @if (canSucOnleme)
                        {
                            <optgroup label="Suç Önleme">
                                <option value="suconleme_VakaSayisi">Vaka Sayısı</option>
                            </optgroup>
                        }
                        @if (canSeyahat)
                        {
                            <optgroup label="Seyahat Belgesi Risk">
                                <option value="seyahat_IslemSayisi">İşlem Sayısı</option>
                            </optgroup>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label for="periodType" class="form-label fw-semibold">Dönem Tipi</label>
                    <select id="periodType" class="form-select">
                        <option value="daily">Günlük</option>
                        <option value="weekly">Haftalık</option>
                        <option value="monthly" selected>Aylık</option>
                        <option value="yearly">Yıllık</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="border rounded p-4 bg-light shadow-sm">
                        <h5 class="text-primary mb-3"><i class="bi bi-1-circle me-2"></i>Dönem 1 (Baz Dönem)</h5>
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label text-muted mb-1">Başlangıç</label>
                                <input type="date" id="p1StartDate" class="form-control" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label text-muted mb-1">Bitiş</label>
                                <input type="date" id="p1EndDate" class="form-control" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="border rounded p-4 bg-light shadow-sm">
                        <h5 class="text-success mb-3"><i class="bi bi-2-circle me-2"></i>Dönem 2 (Kıyas Dönemi)</h5>
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label text-muted mb-1">Başlangıç</label>
                                <input type="date" id="p2StartDate" class="form-control" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label text-muted mb-1">Bitiş</label>
                                <input type="date" id="p2EndDate" class="form-control" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 text-center mt-4">
                    <button id="btnCompare" class="btn btn-primary btn-lg px-5 shadow-sm rounded-pill">
                        <i class="bi bi-arrow-left-right me-2"></i> Karşılaştır
                    </button>
                </div>
            </div>

            <div id="comparisonResults" style="display: none;">
                <hr class="my-4" />
                <h4 class="mb-3">Karşılaştırma Sonuçları</h4>
                <div id="comparisonTable" class="table-responsive"></div>
                <div class="card mt-4 border-0 shadow-sm">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold">Karşılaştırma Grafiği</h6>
                        <div class="btn-group btn-group-sm">
                            <button id="btnDownloadCompJpeg" class="btn btn-outline-secondary">
                                <i class="bi bi-file-image"></i> JPEG
                            </button>
                            <button id="btnDownloadCompPng" class="btn btn-outline-secondary">
                                <i class="bi bi-file-image"></i> PNG
                            </button>
                        </div>
                    </div>
                    <div class="card-body" style="height: 450px;">
                        <canvas id="comparisonChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="~/Scripts/reports/helpers.js"></script>
    <script src="~/Scripts/reports/api-client.js"></script>
    <script src="~/Scripts/reports/chart-module.js"></script>
    <script src="~/Scripts/reports/table-module.js"></script>
    <script src="~/Scripts/reports/comparison-module.js"></script>
    <script src="~/Scripts/reports/main.js"></script>
}
