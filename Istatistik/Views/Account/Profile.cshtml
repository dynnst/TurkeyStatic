@model Istatistik.Models.User

@{
    ViewBag.Title = "Profil";
}

<style>
    :root {
        --primary-color: #2c3e50;
        --secondary-color: #3498db;
        --success-color: #27ae60;
        --danger-color: #e74c3c;
    }

    .profile-container {
        max-width: 600px;
        margin: 40px auto;
    }

    .profile-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        overflow: hidden;
    }

    .profile-card .card-header {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
        color: white;
        padding: 30px 20px;
        text-align: center;
        border: none;
    }

    .profile-card .card-header h3 {
        margin: 0;
        font-weight: 700;
        font-size: 1.5rem;
    }

    .profile-card .card-body {
        padding: 30px;
    }

    .profile-avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--secondary-color) 0%, #2980b9 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        color: white;
        margin: 0 auto 20px;
    }

    .info-group {
        margin-bottom: 25px;
        padding-bottom: 25px;
        border-bottom: 1px solid #e0e0e0;
    }

    .info-group:last-child {
        border-bottom: none;
    }

    .info-label {
        font-weight: 600;
        color: var(--primary-color);
        font-size: 0.9rem;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .info-value {
        font-size: 1.1rem;
        color: #333;
    }

    .badge {
        padding: 8px 15px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .badge-admin {
        background-color: #e74c3c;
        color: white;
    }

    .badge-personnel {
        background-color: #3498db;
        color: white;
    }

    .badge-observer {
        background-color: #95a5a6;
        color: white;
    }

    .action-buttons {
        display: flex;
        gap: 10px;
        margin-top: 25px;
        padding-top: 25px;
        border-top: 1px solid #e0e0e0;
    }

    .btn {
        flex: 1;
        padding: 10px 20px;
        border-radius: 8px;
        border: none;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: var(--secondary-color);
        color: white;
    }

    .btn-primary:hover {
        background-color: #2980b9;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(52, 152, 219, 0.3);
    }

    .btn-danger {
        background-color: var(--danger-color);
        color: white;
    }

    .btn-danger:hover {
        background-color: #c0392b;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(231, 76, 60, 0.3);
    }

    .alert {
        border-radius: 8px;
        border: none;
    }
</style>

<div class="profile-container">
    <div class="card profile-card">
        <div class="card-header">
            <div class="profile-avatar">
                <i class="bi bi-person-fill"></i>
            </div>
            <h3>Profil Bilgileri</h3>
        </div>
        <div class="card-body">
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle"></i> Giriş yaptığınız hesabın detaylı bilgileri aşağıdadır.
            </div>

            <div class="info-group">
                <div class="info-label">
                    <i class="bi bi-person"></i> Adı Soyadı
                </div>
                <div class="info-value">
                    @Model.FullName
                </div>
            </div>

            <div class="info-group">
                <div class="info-label">
                    <i class="bi bi-at"></i> Kullanıcı Adı
                </div>
                <div class="info-value">
                    @Model.Username
                </div>
            </div>

            <div class="info-group">
                <div class="info-label">
                    <i class="bi bi-envelope"></i> E-posta
                </div>
                <div class="info-value">
                    @Model.Email
                </div>
            </div>

            <div class="info-group">
                <div class="info-label">
                    <i class="bi bi-building"></i> Birim
                </div>
                <div class="info-value">
                    @(Session["Border"] as string ?? "Bilinmiyor")
                </div>
            </div>

            <div class="info-group">
                <div class="info-label">
                    <i class="bi bi-shield-check"></i> Rol
                </div>
                <div class="info-value">
                    @if (Model.Role == "SuperAdmin")
                    {
                        <span class="badge badge-admin">Sistem Yöneticisi</span>
                    }
                    else if (Model.Role == "UnitAdmin")
                    {
                        <span class="badge badge-admin">Birim Yöneticisi</span>
                    }
                    else if (Model.Role == "BureauUser")
                    {
                        <span class="badge badge-personnel">Büro Kullanıcısı</span>
                    }
                </div>
            </div>

            <div class="info-group">
                <div class="info-label">
                    <i class="bi bi-calendar-event"></i> Kayıt Tarihi
                </div>
                <div class="info-value">
                    @(Session["LoginTime"] as string ?? "-")
                </div>
            </div>

            <div class="info-group">
                <div class="info-label">
                    <i class="bi bi-clock-history"></i> Son Giriş
                </div>
                <div class="info-value">
                    @if (Model.LastLoginDate.HasValue)
                    {
                        <span>@Model.LastLoginDate.Value.ToString("dd.MM.yyyy HH:mm")</span>
                    }
                    else
                    {
                        <span>Henüz giriş yapılmadı</span>
                    }
                </div>
            </div>

            <div class="action-buttons">
                @Html.ActionLink("?? Ana Sayfa", "Index", "Home", null, new { @class = "btn btn-primary" })
                @Html.ActionLink("?? Çıkış", "Logout", "Account", null, new { @class = "btn btn-danger" })
            </div>
        </div>
    </div>
</div>
