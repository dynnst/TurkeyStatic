```cshtml
@{
    ViewBag.Title = "Suç Önleme - Günlük Veri Girişi";

    var userFullName = Session["FullName"] as string ?? "Kullanıcı";
    var userRole = Session["UserRole"] as string ?? "Ziyaretçi";
    var userBorder = Session["Border"] as string ?? "";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Suç Önleme - Günlük Veri Giriş Sistemi</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>
        :root {
            --primary-color: #1f2937;
            --secondary-color: #2563eb;
            --success-color: #198754;
            --danger-color: #dc3545;
            --warning-color: #ffc107;
            --light-bg: #f5f7fa;
        }

        * {
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            margin: 0;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        .navbar {
            background-color: var(--primary-color);
            box-shadow: 0 2px 10px rgba(0, 0, 0, .15);
        }

        .navbar-brand {
            font-weight: 600;
            font-size: 1.35rem;
        }

        .container-main {
            max-width: 1250px;
            margin: 30px auto;
            padding: 0 20px 30px;
        }

        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0, 0, 0, .15);
            margin-bottom: 20px;
            overflow: hidden;
        }

        .card-header {
            background: linear-gradient(
                135deg,
                var(--primary-color) 0%,
                var(--secondary-color) 100%
            );
            color: #fff;
            padding: 20px 25px;
            font-weight: 600;
            border: none;
            font-size: 1.05rem;
        }

        .card-body {
            padding: 30px;
            background: #fff;
        }

        .form-label {
            font-weight: 600;
            color: var(--primary-color);
            margin-bottom: 8px;
        }

        .form-control,
        .form-select {
            border-radius: 8px;
            border: 2px solid #e1e5eb;
            padding: 10px 14px;
            min-height: 45px;
            transition: all .2s ease;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--secondary-color);
            box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .15);
        }

        textarea.form-control {
            min-height: 90px;
            resize: vertical;
        }

        .form-control::placeholder {
            color: #999;
        }

        .btn-primary,
        .btn-success,
        .btn-danger,
        .btn-secondary {
            border-radius: 8px;
            padding: 10px 22px;
            font-weight: 600;
            transition: all .2s ease;
        }

        .btn-primary {
            background-color: var(--secondary-color);
            border: none;
        }

        .btn-primary:hover {
            background-color: #1d4ed8;
            transform: translateY(-1px);
        }

        .btn-success {
            background-color: var(--success-color);
            border: none;
        }

        .btn-success:hover {
            background-color: #157347;
            transform: translateY(-1px);
        }

        .nav-tabs {
            border-bottom: 2px solid #e5e7eb;
        }

        .nav-tabs .nav-link {
            color: var(--primary-color);
            border: none;
            border-bottom: 3px solid transparent;
            font-weight: 600;
            padding: 12px 18px;
        }

        .nav-tabs .nav-link:hover {
            border-bottom-color: var(--secondary-color);
            color: var(--secondary-color);
        }

        .nav-tabs .nav-link.active {
            border-bottom-color: var(--secondary-color);
            color: var(--secondary-color);
            background: transparent;
        }

        .tab-content {
            padding-top: 20px;
        }

        .tab-content h5 {
            color: var(--primary-color);
            font-weight: 700;
        }

        .row-form-group {
            display: grid;
            grid-template-columns: repeat(
                auto-fit,
                minmax(220px, 1fr)
            );
            gap: 15px;
            margin-bottom: 18px;
        }

        .action-buttons {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #e5e7eb;
        }

        .date-picker-wrapper {
            position: relative;
        }

        .date-picker-wrapper input {
            padding-left: 42px;
        }

        .date-picker-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--secondary-color);
            z-index: 2;
        }

        .summary-card {
            background: linear-gradient(
                135deg,
                var(--secondary-color) 0%,
                #1d4ed8 100%
            );
            color: #fff;
            border-radius: 12px;
            padding: 22px;
            margin-bottom: 15px;
            min-height: 130px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, .12);
        }

        .summary-card h5 {
            margin-bottom: 12px;
            font-weight: 600;
            font-size: 1rem;
        }

        .summary-card .summary-value {
            font-size: 2.2rem;
            font-weight: 700;
        }

        .alert {
            border-radius: 8px;
            border: none;
        }

        .table-responsive {
            border-radius: 8px;
            overflow-x: auto;
            border: 1px solid #e5e7eb;
        }

        table {
            margin-bottom: 0 !important;
            vertical-align: middle;
        }

        thead {
            background-color: var(--primary-color);
            color: #fff;
        }

        thead th {
            white-space: nowrap;
            padding: 12px;
        }

        tbody td {
            padding: 12px;
        }

        tbody tr:hover {
            background-color: #f8f9fa;
        }

        .spinner {
            display: none;
        }

        .spinner.active {
            display: flex;
            align-items: center;
            justify-content: center;
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, .5);
            z-index: 9999;
        }

        .user-badge {
            color: #fff;
            font-size: .9rem;
        }

        .required-mark {
            color: var(--danger-color);
        }

        @@media (max-width: 768px) {
            .container-main {
                margin-top: 15px;
                padding: 0 10px 20px;
            }

            .card-body {
                padding: 18px;
            }

            .navbar-brand {
                font-size: 1rem;
            }

            .action-buttons {
                flex-direction: column;
            }

            .action-buttons button {
                width: 100%;
            }
        }
    </style>
</head>

<body>

    <!-- Kullanıcı Bilgileri -->
    <div id="userInfo"
         data-fullname="@userFullName"
         data-role="@userRole"
         data-unitid="0"
         data-border="@userBorder"
         style="display:none;">
    </div>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid">

            <a class="navbar-brand" href="#">
                <i class="bi bi-shield-lock me-2"></i>
                Antalya Gazipaşa Havalimanı Emniyet Şube
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Menüyü Aç">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item">
                        <a class="nav-link active" href="#veriGirisi">
                            <i class="bi bi-pencil-square me-1"></i>
                            Veri Girişi
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#raporlar">
                            <i class="bi bi-bar-chart me-1"></i>
                            Raporlar
                        </a>
                    </li>

                    <li class="nav-item">
                        <span class="nav-link user-badge" id="kullaniciAdi">
                        </span>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <!-- ANA İÇERİK -->
    <div class="container-main" id="veriGirisi">

        <!-- Alert -->
        <div id="alertContainer"></div>

        <!-- ANA KART -->
        <div class="card">

            <div class="card-header">
                <i class="bi bi-pencil-square me-2"></i>
                Suç Önleme Birimi Günlük Veri Giriş Formu
            </div>

            <div class="card-body">

                <!-- TARİH / BİRİM -->
                <div class="row mb-4">

                    <div class="col-md-6 mb-3 mb-md-0">

                        <label for="entryDate" class="form-label">
                            <i class="bi bi-calendar-event me-1"></i>
                            Veri Giriş Tarihi
                            <span class="required-mark">*</span>
                        </label>

                        <div class="date-picker-wrapper">

                            <i class="bi bi-calendar-event date-picker-icon"></i>

                            <input type="date"
                                   class="form-control"
                                   id="entryDate"
                                   required />

                        </div>

                    </div>

                    <div class="col-md-6">

                        <label for="unitSelect" class="form-label">
                            <i class="bi bi-building me-1"></i>
                            Birim
                            <span class="required-mark">*</span>
                        </label>

                        <select class="form-select"
                                id="unitSelect"
                                required>

                            <option value="">
                                Birim Seçiniz...
                            </option>

                        </select>

                    </div>

                </div>

                <!-- TABLAR -->
                <ul class="nav nav-tabs mb-4"
                    role="tablist">

                    <li class="nav-item" role="presentation">

                        <button class="nav-link active"
                                id="crimeTab"
                                data-bs-toggle="tab"
                                data-bs-target="#crimeContent"
                                type="button"
                                role="tab">

                            <i class="bi bi-exclamation-circle me-1"></i>
                            Ceraim İstatistikleri

                        </button>

                    </li>

                    <li class="nav-item" role="presentation">

                        <button class="nav-link"
                                id="queryTab"
                                data-bs-toggle="tab"
                                data-bs-target="#queryContent"
                                type="button"
                                role="tab">

                            <i class="bi bi-search me-1"></i>
                            Sorgu İstatistikleri

                        </button>

                    </li>

                    <li class="nav-item" role="presentation">

                        <button class="nav-link"
                                id="activityTab"
                                data-bs-toggle="tab"
                                data-bs-target="#activityContent"
                                type="button"
                                role="tab">

                            <i class="bi bi-activity me-1"></i>
                            Arama/Yakalama

                        </button>

                    </li>

                </ul>

                <div class="tab-content">

                    <!-- ==================== CERAİM ==================== -->

                    <div class="tab-pane fade show active"
                         id="crimeContent"
                         role="tabpanel">

                        <h5 class="mb-4">
                            Ceraim (Olay/Suç) İstatistikleri
                        </h5>

                        <form id="crimeForm">

                            <div class="row-form-group">

                                <div>
                                    <label for="crimeType"
                                           class="form-label">
                                        Suç Türü
                                        <span class="required-mark">*</span>
                                    </label>

                                    <input type="text"
                                           class="form-control"
                                           id="crimeType"
                                           placeholder="Örn: Uyuşturucu, Hırsızlık"
                                           required />
                                </div>

                                <div>
                                    <label for="crimeCode"
                                           class="form-label">
                                        Suç Kodu
                                    </label>

                                    <input type="text"
                                           class="form-control"
                                           id="crimeCode"
                                           placeholder="Örn: TCK 188" />
                                </div>

                            </div>

                            <div class="row-form-group">

                                <div>
                                    <label for="casesRequiringFollowUp"
                                           class="form-label">
                                        Takibi Gereken Olay Sayısı
                                    </label>

                                    <input type="number"
                                           class="form-control"
                                           id="casesRequiringFollowUp"
                                           min="0"
                                           value="0" />
                                </div>

                                <div>
                                    <label for="crimesSuspectCount"
                                           class="form-label">
                                        Şüpheli Sayısı
                                    </label>

                                    <input type="number"
                                           class="form-control"
                                           id="crimesSuspectCount"
                                           min="0"
                                           value="0" />
                                </div>

                                <div>
                                    <label for="crimesArrestedCount"
                                           class="form-label">
                                        Tutuklanan Sayısı
                                    </label>

                                    <input type="number"
                                           class="form-control"
                                           id="crimesArrestedCount"
                                           min="0"
                                           value="0" />
                                </div>

                                <div>
                                    <label for="crimesJudicialControl"
                                           class="form-label">
                                        Adli Kontrol Alınan
                                    </label>

                                    <input type="number"
                                           class="form-control"
                                           id="crimesJudicialControl"
                                           min="0"
                                           value="0" />
                                </div>

                            </div>

                            <div>
                                <label for="crimesNotes"
                                       class="form-label">
                                    Notlar
                                </label>

                                <textarea class="form-control"
                                          id="crimesNotes"
                                          rows="3"
                                          placeholder="Ek bilgi..."></textarea>
                            </div>

                            <div class="action-buttons">

                                <button type="button"
                                        class="btn btn-secondary"
                                        id="crimeClearBtn">

                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                    Temizle

                                </button>

                                <button type="button"
                                        class="btn btn-success"
                                        id="crimeSaveBtn">

                                    <i class="bi bi-check-circle me-1"></i>
                                    Kaydet

                                </button>

                            </div>

                        </form>

                        <hr class="my-4" />

                        <h6 class="mb-3">
                            Kaydedilen Ceraim İstatistikleri
                        </h6>

                        <div class="table-responsive">

                            <table class="table table-hover"
                                   id="crimeTable">

                                <thead>
                                    <tr>
                                        <th>Suç Türü</th>
                                        <th>Suç Kodu</th>
                                        <th>Şüpheli</th>
                                        <th>Tutuklanan</th>
                                        <th>Tarih</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>

                                <tbody id="crimeTableBody">
                                </tbody>

                            </table>

                        </div>

                    </div>


                    <!-- ==================== SORGU ==================== -->

                    <div class="tab-pane fade"
                         id="queryContent"
                         role="tabpanel">

                        <h5 class="mb-4">
                            GBT/YTS Sorgu İstatistikleri
                        </h5>

                        <form id="queryForm">

                            <div class="row-form-group">

                                <div>

                                    <label for="queryShift"
                                           class="form-label">
                                        Vardiya/Büro
                                        <span class="required-mark">*</span>
                                    </label>

                                    <select class="form-select"
                                            id="queryShift"
                                            required>

                                        <option value="">
                                            Seçiniz...
                                        </option>

                                        <option value="1. Vardiya">
                                            1. Vardiya
                                        </option>

                                        <option value="2. Vardiya">
                                            2. Vardiya
                                        </option>

                                        <option value="3. Vardiya">
                                            3. Vardiya
                                        </option>

                                        <option value="İdari Büro">
                                            İdari Büro
                                        </option>

                                    </select>

                                </div>

                                <div>

                                    <label for="queryOperationType"
                                           class="form-label">
                                        İşlem Türü
                                    </label>

                                    <select class="form-select"
                                            id="queryOperationType">

                                        <option value="Günlük Takibat">
                                            Günlük Takibat
                                        </option>

                                    </select>

                                </div>

                            </div>

                            <div class="row-form-group">

                                <div>

                                    <label for="queryPersonQueried"
                                           class="form-label">
                                        Sorgulanan Şahıs Sayısı
                                    </label>

                                    <input type="number"
                                           class="form-control"
                                           id="queryPersonQueried"
                                           min="0"
                                           value="0" />

                                </div>

                                <div>

                                    <label for="queryPersonArrestedSearched"
                                           class="form-label">
                                        Yakalanan/Aranan Şahıs Sayısı
                                    </label>

                                    <input type="number"
                                           class="form-control"
                                           id="queryPersonArrestedSearched"
                                           min="0"
                                           value="0" />

                                </div>

                            </div>

                            <div>

                                <label for="queryNotes"
                                       class="form-label">
                                    Notlar
                                </label>

                                <textarea class="form-control"
                                          id="queryNotes"
                                          rows="3"
                                          placeholder="Ek bilgi..."></textarea>

                            </div>

                            <div class="action-buttons">

                                <button type="button"
                                        class="btn btn-secondary"
                                        id="queryClearBtn">

                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                    Temizle

                                </button>

                                <button type="button"
                                        class="btn btn-success"
                                        id="querySaveBtn">

                                    <i class="bi bi-check-circle me-1"></i>
                                    Kaydet

                                </button>

                            </div>

                        </form>

                        <hr class="my-4" />

                        <h6 class="mb-3">
                            Kaydedilen Sorgu İstatistikleri
                        </h6>

                        <div class="table-responsive">

                            <table class="table table-hover"
                                   id="queryTable">

                                <thead>
                                    <tr>
                                        <th>Vardiya/Büro</th>
                                        <th>Sorgulanan</th>
                                        <th>Yakalanan/Aranan</th>
                                        <th>İşlem Türü</th>
                                        <th>Tarih</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>

                                <tbody id="queryTableBody">
                                </tbody>

                            </table>

                        </div>

                    </div>


                    <!-- ==================== ARAMA / YAKALAMA ==================== -->

                    <div class="tab-pane fade"
                         id="activityContent"
                         role="tabpanel">

                        <h5 class="mb-4">
                            Arama/Yakalama Faaliyetleri
                        </h5>

                        <form id="activityForm">

                            <div class="row-form-group">

                                <div>

                                    <label for="activityWarrantSource"
                                           class="form-label">
                                        Yakalama Emri Kaynağı
                                    </label>

                                    <select class="form-select"
                                            id="activityWarrantSource">

                                        <option value="GBT">
                                            GBT Kaynaklı
                                        </option>

                                        <option value="UAP">
                                            UAP Kaynaklı
                                        </option>

                                        <option value="İcra">
                                            İcra Kaynaklı
                                        </option>

                                    </select>

                                </div>

                                <div>

                                    <label for="activityWarrantCount"
                                           class="form-label">
                                        Yakalama Emri Sayısı
                                    </label>

                                    <input type="number"
                                           class="form-control"
                                           id="activityWarrantCount"
                                           min="0"
                                           value="0" />

                                </div>

                            </div>

                            <div class="row-form-group">

                                <div>

                                    <label for="activityApprehendedCount"
                                           class="form-label">
                                        Yakalanan Sayısı
                                    </label>

                                    <input type="number"
                                           class="form-control"
                                           id="activityApprehendedCount"
                                           min="0"
                                           value="0" />

                                </div>

                                <div>

                                    <label for="activityArrestedCount"
                                           class="form-label">
                                        Tutuklanan
                                    </label>

                                    <input type="number"
                                           class="form-control"
                                           id="activityArrestedCount"
                                           min="0"
                                           value="0" />

                                </div>

                            </div>

                            <div>

                                <label for="activityLocation"
                                       class="form-label">
                                    Yakalama Yeri/Noktası
                                </label>

                                <input type="text"
                                       class="form-control"
                                       id="activityLocation"
                                       placeholder="Örn: Havalimanı, Şehir Merkezi" />

                            </div>

                            <div class="mt-3">

                                <label for="activityNotes"
                                       class="form-label">
                                    Notlar
                                </label>

                                <textarea class="form-control"
                                          id="activityNotes"
                                          rows="3"
                                          placeholder="Ek bilgi..."></textarea>

                            </div>

                            <div class="action-buttons">

                                <button type="button"
                                        class="btn btn-secondary"
                                        id="activityClearBtn">

                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                    Temizle

                                </button>

                                <button type="button"
                                        class="btn btn-success"
                                        id="activitySaveBtn">

                                    <i class="bi bi-check-circle me-1"></i>
                                    Kaydet

                                </button>

                            </div>

                        </form>

                        <hr class="my-4" />

                        <h6 class="mb-3">
                            Kaydedilen Arama/Yakalama Faaliyetleri
                        </h6>

                        <div class="table-responsive">

                            <table class="table table-hover"
                                   id="activityTable">

                                <thead>
                                    <tr>
                                        <th>Yakalama Emri Kaynağı</th>
                                        <th>Yakalanan</th>
                                        <th>Tutuklanan</th>
                                        <th>Yer/Nokta</th>
                                        <th>Tarih</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>

                                <tbody id="activityTableBody">
                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            </div>
        </div>


        <!-- ==================== ÖZET KARTLARI ==================== -->

        <div class="row mt-4">

            <div class="col-md-3">
                <div class="summary-card">
                    <h5>
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Toplam Suçlar
                    </h5>
                    <div class="summary-value"
                         id="totalCrimes">
                        0
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="summary-card">
                    <h5>
                        <i class="bi bi-person me-1"></i>
                        Toplam Şüpheliler
                    </h5>
                    <div class="summary-value"
                         id="totalSuspects">
                        0
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="summary-card">
                    <h5>
                        <i class="bi bi-lock me-1"></i>
                        Toplam Tutuklama
                    </h5>
                    <div class="summary-value"
                         id="totalArrested">
                        0
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="summary-card">
                    <h5>
                        <i class="bi bi-search me-1"></i>
                        Toplam Sorgulama
                    </h5>
                    <div class="summary-value"
                         id="totalQueries">
                        0
                    </div>
                </div>
            </div>

        </div>

    </div>


    <!-- ==================== LOADING ==================== -->

    <div class="spinner"
         id="loadingSpinner">

        <div class="spinner-border text-light"
             role="status">

            <span class="visually-hidden">
                Yükleniyor...
            </span>

