        var INAD_REASONS = ["Vize Ýhlali", "Geçerli Seyahat Belgesi Olmamasý", "Sahte Belge Kullanýmý", "Kamu Düzeni/Güvenliði Tehdidi", "Yeterli Maddi Kaynak Gösterememe", "Geliþ Amacýný Ýzah Edememe", "Giriþ Yasaðý Bulunmasý", "Diðer Sebepler"];


        
